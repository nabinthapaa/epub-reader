import { Tokens, ToolButton, ThemedField, ThemedCheck, TocRow, SearchRow, ShelfRow } from "tokens.slint";
import { ScrollView } from "std-widgets.slint";

// Table of contents, flattened with indentation per nesting level.
export component TocPanel inherits Rectangle {
    in property <Tokens> tokens;
    in property <[TocRow]> rows;
    in property <int> current-index: -1;
    callback activate(int);

    // Called when the panel opens rather than bound to viewport-y: the user's
    // own scrolling writes that property, which would replace a binding and
    // leave the panel stuck forever after.
    public function reveal-current() {
        if (current-index > 0) {
            // Rows wrap, so this estimates from an average row height rather
            // than measuring — close enough to save a hunt in a long book.
            list.viewport-y = -clamp(current-index * 33px - list.height / 3,
                0px, max(0px, list.viewport-height - list.height));
        }
    }

    // Width is the parent's business: it has to balance this against the
    // measure, and a width set here outranks the max-width it tries to apply.
    background: tokens.surface;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: tokens.border;
    }

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        HorizontalLayout {
            // The rows inset their labels another 10px for the hover shape, so
            // the header has to match or it sits 10px left of the list.
            padding-left: 10px;
            vertical-stretch: 0;
            Text {
                text: "CONTENTS";
                color: tokens.muted;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 0.6px;
            }
        }

        list := ScrollView {
            // The panel already has a border; the widget scrollbar draws a
            // second vertical line 15px inside it.
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            VerticalLayout {
                spacing: 1px;
                for row in rows: Rectangle {
                    height: label.preferred-height + 12px;
                    border-radius: 5px;
                    background: row.current
                        ? tokens.accent.with-alpha(0.16)
                        : (hover.has-hover ? tokens.text.with-alpha(0.06) : transparent);

                    // A tint at 0.16 alpha is nearly invisible in the dark
                    // theme, so the current entry also gets a bar.
                    if row.current: Rectangle {
                        x: 0;
                        width: 3px;
                        height: parent.height;
                        border-radius: 1.5px;
                        background: tokens.accent;
                    }

                    label := Text {
                        x: 10px + row.depth * 12px;
                        width: parent.width - self.x - 8px;
                        text: row.label;
                        color: row.current ? tokens.accent : tokens.text;
                        font-size: 13px;
                        font-weight: row.current ? 600 : 400;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }

                    hover := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { activate(row.index); }
                    }
                }
            }
        }
    }

    // A 135-row contents was sliced mid-glyph at the panel's lower edge with
    // nothing to say it continued. Sibling of the layout, so it sits on that
    // edge rather than inside the padding.
    Rectangle {
        y: parent.height - 24px;
        height: 24px;
        background: @linear-gradient(180deg,
            tokens.surface.with-alpha(0.0) 0%, tokens.surface 100%);
    }
}

// In-book search: a query field and its results.
export component SearchPanel inherits Rectangle {
    in property <Tokens> tokens;
    in property <[SearchRow]> results;
    in property <bool> searching;
    callback run(string);
    callback activate(int);
    callback dismissed();

    // As TocPanel: the parent sizes this.
    background: tokens.surface;

    Rectangle {
        // Without an x, Slint centres a child whose size is set but whose
        // position is not: the divider was running down the panel's middle.
        x: 0;
        width: 1px;
        background: tokens.border;
    }

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        field := ThemedField {
            tokens: tokens;
            placeholder: "Search this book";
            accepted(text) => { run(text); }
            escaped => { root.dismissed(); }
        }

        HorizontalLayout {
            // Lands on the same left edge as the snippets below it.
            padding-left: 8px;
            vertical-stretch: 0;
            Text {
                text: searching
                    ? "SEARCHING…"
                    : (results.length > 0 ? results.length + " MATCHES" : "NO MATCHES");
                color: tokens.muted;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 0.6px;
            }
        }

        ScrollView {
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            VerticalLayout {
                // Hits were 14px apart while a hit's own label and snippet sat
                // 12px apart, so the list read as one stack rather than as
                // separate results. The gap between has to beat the gap within.
                spacing: 10px;
                for row in results: Rectangle {
                    height: content.preferred-height + 12px;
                    border-radius: 5px;
                    background: hover.has-hover ? tokens.text.with-alpha(0.06) : transparent;

                    content := VerticalLayout {
                        x: 8px;
                        width: parent.width - 16px;
                        y: 6px;
                        spacing: 2px;
                        Text {
                            text: row.label;
                            color: tokens.muted;
                            font-size: 11px;
                            overflow: elide;
                        }
                        StyledText {
                            text: row.snippet;
                            default-color: tokens.text;
                            default-font-size: 12px;
                            width: parent.width;
                        }
                    }

                    hover := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { activate(row.index); }
                    }
                }
            }
        }
    }

    Rectangle {
        y: parent.height - 24px;
        height: 24px;
        background: @linear-gradient(180deg,
            tokens.surface.with-alpha(0.0) 0%, tokens.surface 100%);
    }

    public function focus-field() {
        field.focus-field();
    }

    /// The field owns its own text, so this is the only way in from Rust.
    /// Used by the screenshot tool, which would otherwise photograph a list of
    /// matches above an empty search box.
    public function set-query(text: string) {
        field.text = text;
    }
}

// The start screen: recently opened books, newest first.
export component Shelf inherits Rectangle {
    in property <Tokens> tokens;
    in property <[ShelfRow]> books;
    callback open-book(int);
    callback open-file();

    // Tile geometry, pinned: inside a layout a plain width/height is only
    // advisory, so the tiles have to state minimum and maximum alike or they
    // collapse to whatever their contents happen to need.
    private property <length> tile-width: 164px;
    private property <length> cover-height: 212px;
    private property <length> tile-height: 304px;
    private property <length> gap: 16px;
    // The tiles carry 8px of padding of their own (it is what the hover
    // highlight needs), so the page padding is 8px short of the margin and the
    // text rows make it up. Otherwise the heading sits 8px left of the covers.
    private property <length> pad: 28px;
    private property <length> text-inset: 8px;

    // Slint has no wrapping layout, so the grid is positioned by hand from the
    // width that is actually available. One row that scrolls sideways hid
    // books behind the window edge with nothing to say they were there.
    private property <length> shelf-width: max(root.width - 2 * root.pad, root.tile-width);
    private property <int> columns: max(1, floor((root.shelf-width + root.gap) / (root.tile-width + root.gap)));
    // Every book, plus the cell that opens a new one.
    private property <int> cells: books.length + 1;
    private property <int> rows: ceil(root.cells / root.columns);

    background: tokens.page;

    VerticalLayout {
        padding: root.pad;
        spacing: 16px;

        HorizontalLayout {
            padding-left: root.text-inset;
            vertical-stretch: 0;
            Text {
                text: "Folio";
                color: tokens.text;
                font-size: 28px;
                font-weight: 700;
            }
        }

        HorizontalLayout {
            padding-left: root.text-inset;
            vertical-stretch: 0;
            Text {
                text: books.length > 0 ? "Continue reading" : "Open an EPUB to start reading";
                color: tokens.muted;
                font-size: 13px;
            }
        }

        Flickable {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: root.rows * (root.tile-height + root.gap);

            for book[index] in books: Rectangle {
                x: (index - floor(index / root.columns) * root.columns) * (root.tile-width + root.gap);
                y: floor(index / root.columns) * (root.tile-height + root.gap);
                width: root.tile-width;
                height: root.tile-height;
                border-radius: 8px;
                background: tile.has-hover ? tokens.text.with-alpha(0.07) : transparent;
                animate background { duration: 90ms; }

                VerticalLayout {
                    padding: 8px;
                    spacing: 8px;
                    alignment: start;

                    Rectangle {
                        min-height: root.cover-height;
                        max-height: root.cover-height;
                        border-radius: 4px;
                        background: tokens.surface;
                        border-width: 1px;
                        // `border` is 1.3:1 on surface, which is right for a
                        // hairline between panels and too faint to contain a
                        // cream-coloured cover.
                        border-color: tokens.muted.with-alpha(0.4);
                        clip: true;

                        if book.cover.width > 0: Image {
                            source: book.cover;
                            width: parent.width;
                            height: parent.height;
                            image-fit: contain;
                        }
                        // A bare fill meant 1% of a 148px cover was a single
                        // accent pixel in the corner, indistinguishable from an
                        // antialiasing artifact — on the one screen whose job
                        // is to say where you left off.
                        if book.progress > 0: Rectangle {
                            y: parent.height - 3px;
                            x: 0;
                            width: parent.width;
                            height: 3px;
                            background: tokens.border;
                            Rectangle {
                                x: 0;
                                width: max(4px, parent.width * book.progress / 100);
                                height: parent.height;
                                background: tokens.accent;
                            }
                        }
                        // Books with no cover get their title instead of a
                        // blank rectangle.
                        if book.cover.width == 0: Text {
                            text: book.title;
                            color: tokens.muted;
                            font-size: 13px;
                            width: parent.width - 20px;
                            x: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            overflow: elide;
                        }
                    }

                    Text {
                        text: book.title;
                        color: tokens.text;
                        font-size: 12px;
                        font-weight: 600;
                        wrap: word-wrap;
                        // Three lines are reserved. With `wrap` set, eliding
                        // only touches the line that overflows, so a long
                        // title ends in an ellipsis rather than mid-x-height.
                        overflow: elide;
                        // Three 16px lines plus the slack `elide` needs to
                        // place an ellipsis on the third rather than the second.
                        min-height: 54px;
                        max-height: 54px;
                    }

                    Text {
                        text: book.author;
                        color: tokens.muted;
                        font-size: 11px;
                        overflow: elide;
                        min-height: 14px;
                    }
                }

                tile := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { open-book(book.index); }
                }
            }

            // Matches the cover box, not the whole tile, so the row of
            // artwork reads as one band.
            Rectangle {
                x: (books.length - floor(books.length / root.columns) * root.columns) * (root.tile-width + root.gap);
                y: floor(books.length / root.columns) * (root.tile-height + root.gap);
                width: root.tile-width;
                height: root.tile-height;

                add-box := Rectangle {
                    y: 8px;
                    x: 8px;
                    width: parent.width - 16px;
                    height: root.cover-height;
                    // 4px, as the cover boxes it stands in a row with.
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: tokens.border;
                    background: add.has-hover ? tokens.text.with-alpha(0.07) : transparent;
                    animate background { duration: 90ms; }
                }

                VerticalLayout {
                    // 2px up: the 30px glyph carries unused ascender space, so
                    // centring the box leaves the ink sitting low in it.
                    y: 6px;
                    height: root.cover-height;
                    alignment: center;
                    spacing: 6px;
                    Text {
                        text: "+";
                        color: tokens.muted;
                        font-size: 30px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Open file…";
                        color: tokens.muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                }

                add := TouchArea {
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    height: root.cover-height;
                    mouse-cursor: pointer;
                    clicked => { open-file(); }
                }
            }
        }

        HorizontalLayout {
            padding-left: root.text-inset;
            vertical-stretch: 0;
            Text {
                text: "Ctrl+O opens a book · ? for keyboard shortcuts";
                color: tokens.muted;
                font-size: 11px;
            }
        }
    }
}

// Reading settings: the knobs that change how text is set.
export component SettingsPanel inherits Rectangle {
    in property <Tokens> tokens;
    in property <[string]> families;
    in property <int> family-index;
    in property <bool> justify;
    in property <bool> spotlight;
    in property <bool> follow-system;
    in property <string> theme-label;
    in property <int> measure;

    callback pick-family(int);
    callback set-justify(bool);
    callback set-spotlight(bool);
    callback set-follow-system(bool);
    callback pick-theme(int);
    callback set-measure(int);
    callback dismiss();
    callback show-shortcuts();

    private property <bool> picking-family: false;

    width: 304px;
    // Sized to its contents: an absolutely positioned child would otherwise
    // stretch to the full height of the window.
    height: content.preferred-height;
    // Lifted a step off `surface` and given a border that reads at a glance:
    // the drop shadow below draws nothing at all in the software renderer, so
    // elevation cannot depend on it.
    background: tokens.surface.mix(tokens.text, 0.94);
    border-width: 1px;
    border-color: tokens.text.with-alpha(0.22);
    border-radius: 10px;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #000000.with-alpha(0.45);

    content := VerticalLayout {
        padding: 14px;
        spacing: 10px;
        alignment: start;

        Text {
            text: "DISPLAY";
            color: tokens.muted;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.6px;
        }

        HorizontalLayout {
            spacing: 6px;
            ToolButton {
                tokens: tokens;
                text: "Light";
                active: !follow-system && theme-label == "Light";
                clicked => { pick-theme(0); }
            }
            ToolButton {
                tokens: tokens;
                text: "Sepia";
                active: !follow-system && theme-label == "Sepia";
                clicked => { pick-theme(1); }
            }
            ToolButton {
                tokens: tokens;
                text: "Dark";
                active: !follow-system && theme-label == "Dark";
                clicked => { pick-theme(2); }
            }
            ToolButton {
                tokens: tokens;
                text: "Auto";
                active: follow-system;
                clicked => { set-follow-system(!follow-system); }
            }
        }

        Text {
            text: "TYPEFACE";
            color: tokens.muted;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.6px;
        }

        // The installed family, with the list folded away until asked for: a
        // dropdown from the widget library would paint itself off-theme. Shaped
        // like the search field so it reads as a control, not a label.
        Rectangle {
            min-height: 32px;
            max-height: 32px;
            border-radius: 6px;
            background: tokens.page;
            border-width: 1px;
            border-color: picking-family ? tokens.accent : tokens.border;

            Text {
                x: 10px;
                width: parent.width - 34px;
                height: parent.height;
                text: families.length > family-index && family-index >= 0
                    ? families[family-index]
                    : "System serif";
                color: tokens.text;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: parent.width - 22px;
                height: parent.height;
                text: "▾";
                color: tokens.muted;
                font-size: 11px;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { picking-family = !picking-family; }
            }
        }

        if picking-family: Rectangle {
            min-height: 148px;
            max-height: 148px;
            border-radius: 6px;
            background: tokens.page;
            border-width: 1px;
            border-color: tokens.border;

            ScrollView {
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                VerticalLayout {
                    padding: 4px;
                    spacing: 1px;
                    for family[index] in families: Rectangle {
                        min-height: 24px;
                        max-height: 24px;
                        border-radius: 4px;
                        background: index == family-index
                            ? tokens.accent.with-alpha(0.16)
                            : (pick.has-hover ? tokens.text.with-alpha(0.06) : transparent);
                        Text {
                            x: 8px;
                            text: family;
                            color: index == family-index ? tokens.accent : tokens.text;
                            font-size: 12px;
                            vertical-alignment: center;
                            height: parent.height;
                            overflow: elide;
                            width: parent.width - 16px;
                        }
                        pick := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                pick-family(index);
                                picking-family = false;
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: space-between;
            Text {
                text: "Line length";
                color: tokens.text;
                font-size: 12px;
                vertical-alignment: center;
            }
            // One segmented control, matching the toolbar's zoom group.
            Rectangle {
                width: measure-row.preferred-width;
                border-radius: 6px;
                background: tokens.text.with-alpha(0.05);
                measure-row := HorizontalLayout {
                    spacing: 0px;
                    ToolButton {
                        tokens: tokens;
                        text: "−";
                        clicked => { set-measure(measure - 5); }
                    }
                    // A ToolButton, not a Text: the toolbar's zoom group is
                    // built the same way and its middle resets the value, so
                    // this one does too rather than only looking as if it might.
                    ToolButton {
                        tokens: tokens;
                        text: measure + " ch";
                        clicked => { set-measure(70); }
                    }
                    ToolButton {
                        tokens: tokens;
                        text: "+";
                        clicked => { set-measure(measure + 5); }
                    }
                }
            }
        }

        ThemedCheck {
            tokens: tokens;
            text: "Justify paragraphs";
            checked: justify;
            toggled(on) => { set-justify(on); }
        }

        ThemedCheck {
            tokens: tokens;
            text: "Spotlight paragraph in focus";
            checked: spotlight;
            toggled(on) => { set-spotlight(on); }
        }

        // The chip reads as a key cap — "press ? for shortcuts" — but it is
        // styled like a control, so the row opens the card as well.
        Rectangle {
            min-height: 22px;
            max-height: 22px;
            border-radius: 4px;
            background: shortcuts-touch.has-hover ? tokens.text.with-alpha(0.06) : transparent;

            HorizontalLayout {
                padding-left: 2px;
                spacing: 7px;
                alignment: start;
                Text {
                    text: "Keyboard shortcuts";
                    color: tokens.muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 17px;
                    height: 17px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    background: tokens.text.with-alpha(0.08);
                    Text {
                        text: "?";
                        color: tokens.muted;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }

            shortcuts-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.show-shortcuts(); }
            }
        }
    }
}
