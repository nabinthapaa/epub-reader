import { Tokens, Shortcuts, TocRow, SearchRow, ShelfRow } from "tokens.slint";
import { Palette } from "std-widgets.slint";
import { Toolbar } from "toolbar.slint";
import { TocPanel, SearchPanel, Shelf, SettingsPanel } from "panels.slint";

export { Tokens, TocRow, SearchRow, ShelfRow }

export component AppWindow inherits Window {
    // --- state pushed from Rust ---
    in property <Tokens> tokens;
    // The painted band and where it sits, both in logical pixels. The band is
    // taller than the viewport, so scrolling slides it instead of repainting.
    in property <image> band-image;
    in property <length> band-top;
    in property <length> band-height;
    /// The band's own width. Keeping the image at its natural size means a band
    /// that has not caught up with a resize is merely off-centre for a frame,
    /// rather than horizontally squashed.
    in property <length> band-width;
    /// Eased scroll offset, driven from Rust.
    in property <length> scroll;
    in property <length> chapter-height;
    /// Viewport height as a fraction of the chapter, for the scrollbar thumb.
    in property <float> viewport-fraction: 1.0;
    /// 0 while a chapter transition plays, 1 when it has settled.
    in property <float> enter-progress: 1.0;
    /// +1 when moving forward through the book, -1 when going back.
    in property <float> enter-direction: 1.0;
    in property <string> book-title: "Folio";
    in property <string> chapter-label;
    in property <float> progress;
    in property <float> chapter-progress;
    in property <int> font-px: 18;
    in property <bool> has-book;
    in property <bool> can-go-back;
    in property <bool> focus-mode;
    in property <bool> spotlight;
    in property <string> theme-label: "Light";
    in property <string> book-author;
    /// Rough minutes left in the chapter; 0 means "not worth saying".
    in property <int> minutes-left;
    in property <[TocRow]> toc;
    in property <[SearchRow]> search-results;
    in property <[ShelfRow]> shelf;
    in property <bool> searching;
    in property <string> notice;
    in property <[string]> families;
    in property <int> family-index;
    in property <bool> justify;
    in property <bool> follow-system;
    in property <int> measure: 70;

    // What the desktop reports, so "follow system" can resolve a preset.
    out property <bool> system-dark: Palette.color-scheme == ColorScheme.dark;

    in-out property <bool> toc-open;
    in-out property <bool> search-open;
    in-out property <bool> settings-open;
    in-out property <bool> shortcuts-open;

    // --- requests sent to Rust ---
    callback scroll-by(length);
    callback scroll-screens(int);
    callback scroll-steps(int);
    callback jump-chapter(int);
    callback goto-toc(int);
    callback goto-search(int);
    callback run-search(string);
    callback toggle-focus();
    callback toggle-spotlight();
    callback move-spotlight(int);
    callback cycle-theme();
    callback zoom(int);
    callback zoom-reset();
    callback open-file();
    callback open-recent(int);
    callback page-clicked(length, length);
    callback viewport-changed(length, length);
    callback back();
    callback close-book();
    callback quit();
    callback pick-family(int);
    callback set-justify(bool);
    callback set-follow-system(bool);
    callback pick-theme(int);
    callback set-measure(int);

    title: book-title;
    background: tokens.page;
    preferred-width: 1000px;
    preferred-height: 760px;
    min-width: 420px;
    min-height: 360px;
    forward-focus: keys;

    public function focus-reader() {
        keys.focus();
    }

    keys := FocusScope {
        key-pressed(event) => {
            // Escape backs out of whatever is open, innermost first.
            if (event.text == Key.Escape) {
                // Back out one layer at a time, innermost first, ending at the
                // shelf: there has to be a way home from a book.
                if (shortcuts-open) { shortcuts-open = false; return accept; }
                if (settings-open) { settings-open = false; return accept; }
                if (search-open) { search-open = false; return accept; }
                if (focus-mode) { toggle-focus(); return accept; }
                if (toc-open) { toc-open = false; return accept; }
                if (has-book) { close-book(); return accept; }
                return accept;
            }
            if (event.text == "?") { shortcuts-open = !shortcuts-open; return accept; }
            if (shortcuts-open) { shortcuts-open = false; return accept; }
            if (!has-book) {
                if (event.text == "o" && event.modifiers.control) { open-file(); return accept; }
                return reject;
            }
            if (event.modifiers.control) {
                if (event.text == "=" || event.text == "+") { zoom(1); return accept; }
                if (event.text == "-") { zoom(-1); return accept; }
                if (event.text == "0") { zoom-reset(); return accept; }
                if (event.text == "o") { open-file(); return accept; }
                if (event.text == "t") { toc-open = !toc-open; return accept; }
                if (event.text == ",") { settings-open = !settings-open; return accept; }
                if (event.text == "f") {
                    search-open = !search-open;
                    if (search-open) { search-panel.focus-field(); }
                    return accept;
                }
                if (event.text == "q") { quit(); return accept; }
                if (event.text == "w") { close-book(); return accept; }
                return reject;
            }
            if (event.text == Key.PageDown || event.text == " " || event.text == Key.RightArrow) {
                scroll-screens(1);
                return accept;
            }
            if (event.text == Key.PageUp || event.text == Key.LeftArrow) {
                scroll-screens(-1);
                return accept;
            }
            if (event.text == Key.DownArrow || event.text == "j") {
                if (focus-mode && spotlight) { move-spotlight(1); } else { scroll-steps(1); }
                return accept;
            }
            if (event.text == Key.UpArrow || event.text == "k") {
                if (focus-mode && spotlight) { move-spotlight(-1); } else { scroll-steps(-1); }
                return accept;
            }
            if (event.text == Key.Home) { jump-chapter(0); return accept; }
            if (event.text == Key.Backspace) { back(); return accept; }
            if (event.text == "f") { toggle-focus(); return accept; }
            if (event.text == "s") { toggle-spotlight(); return accept; }
            if (event.text == "t") { cycle-theme(); return accept; }
            if (event.text == "c") { toc-open = !toc-open; return accept; }
            if (event.text == "/") {
                search-open = true;
                search-panel.focus-field();
                return accept;
            }
            if (event.text == "n") { jump-chapter(1); return accept; }
            if (event.text == "p") { jump-chapter(-1); return accept; }
            return reject;
        }

        VerticalLayout {
            Toolbar {
                visible: !focus-mode;
                height: focus-mode ? 0px : 46px;
                tokens: tokens;
                title: book-title;
                author: book-author;
                toc-open: toc-open;
                search-open: search-open;
                settings-open: settings-open;
                has-book: has-book;
                can-go-back: can-go-back;
                font-px: font-px;
                toggle-toc => { toc-open = !toc-open; keys.focus(); }
                toggle-search => {
                    search-open = !search-open;
                    if (search-open) { search-panel.focus-field(); }
                }
                open-file => { root.open-file(); }
                zoom(step) => { root.zoom(step); }
                zoom-reset => { root.zoom-reset(); }
                toggle-focus => { root.toggle-focus(); keys.focus(); }
                toggle-settings => { settings-open = !settings-open; }
                close-book => { root.close-book(); }
                back => { root.back(); }
            }

            HorizontalLayout {
                TocPanel {
                    visible: toc-open && !focus-mode && has-book;
                    width: (toc-open && !focus-mode && has-book) ? 260px : 0px;
                    tokens: tokens;
                    rows: toc;
                    activate(index) => { goto-toc(index); keys.focus(); }
                }

                reader-area := Rectangle {
                    horizontal-stretch: 1;
                    background: tokens.page;
                    clip: true;

                    changed width => { viewport-changed(self.width, self.height); }
                    changed height => { viewport-changed(self.width, self.height); }

                    if has-book: Image {
                        source: band-image;
                        width: root.band-width > 0 ? root.band-width : parent.width;
                        x: (parent.width - self.width) / 2;
                        height: root.band-height;
                        // Chapter space -> viewport space, plus the small
                        // offset a chapter transition slides in from.
                        y: root.band-top - root.scroll
                            + (1.0 - root.enter-progress) * root.enter-direction * 42px;
                        opacity: 0.15 + 0.85 * root.enter-progress;
                        image-fit: fill;
                        image-rendering: pixelated;
                    }

                    if !has-book: Shelf {
                        width: parent.width;
                        height: parent.height;
                        tokens: tokens;
                        books: shelf;
                        open-book(index) => { open-recent(index); }
                        open-file => { root.open-file(); }
                    }

                    if has-book: TouchArea {
                        mouse-cursor: default;
                        clicked => {
                            page-clicked(self.mouse-x, self.mouse-y);
                            keys.focus();
                        }
                        scroll-event(event) => {
                            if (event.modifiers.control) {
                                root.zoom(event.delta-y > 0 ? 1 : -1);
                                return accept;
                            }
                            if (event.delta-y != 0) {
                                // Wheel deltas are already in logical pixels;
                                // Rust clamps and crosses chapters.
                                root.scroll-by(-event.delta-y);
                                return accept;
                            }
                            return reject;
                        }
                    }

                    if has-book && chapter-height > parent.height: Rectangle {
                        x: parent.width - 7px;
                        width: 3px;
                        y: 4px + (parent.height - 8px - self.height) * root.chapter-progress;
                        height: max(28px, (parent.height - 8px) * root.viewport-fraction);
                        border-radius: 1.5px;
                        background: tokens.text;
                        opacity: focus-mode ? 0.0 : 0.18;
                        animate opacity { duration: 160ms; }
                    }

                    // Lines are cut by the viewport edges; fading them says
                    // "there is more" instead of looking like clipping damage.
                    if has-book: Rectangle {
                        y: 0;
                        height: 20px;
                        background: @linear-gradient(180deg,
                            tokens.page 0%, tokens.page.with-alpha(0.0) 100%);
                    }
                    if has-book: Rectangle {
                        y: parent.height - 28px;
                        height: 28px;
                        background: @linear-gradient(180deg,
                            tokens.page.with-alpha(0.0) 0%, tokens.page 100%);
                    }

                    // In focus mode the only chrome left is a hairline of progress.
                    if focus-mode: Rectangle {
                        y: parent.height - 2px;
                        x: 0;
                        width: parent.width;
                        height: 2px;
                        background: tokens.text.with-alpha(0.07);
                        Rectangle {
                            x: 0;
                            width: parent.width * progress;
                            height: parent.height;
                            background: tokens.muted.with-alpha(0.5);
                        }
                    }
                }

                search-panel := SearchPanel {
                    visible: search-open && !focus-mode && has-book;
                    width: (search-open && !focus-mode && has-book) ? 300px : 0px;
                    tokens: tokens;
                    results: search-results;
                    searching: searching;
                    run(query) => { run-search(query); }
                    activate(index) => { goto-search(index); keys.focus(); }
                    dismissed => { search-open = false; keys.focus(); }
                }
            }

            Rectangle {
                visible: !focus-mode && has-book;
                height: (!focus-mode && has-book) ? 28px : 0px;
                background: tokens.surface;

                Rectangle {
                    y: 0;
                    height: 1px;
                    background: tokens.border;
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;

                    Text {
                        text: chapter-label;
                        color: tokens.muted;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        // What a reader actually wants to know. The scrollbar
                        // already shows position within the chapter.
                        text: minutes-left > 0 ? "~" + minutes-left + " min left" : "";
                        color: tokens.muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 90px;
                        height: 4px;
                        y: (parent.height - 4px) / 2;
                        border-radius: 2px;
                        background: tokens.border;
                        Rectangle {
                            x: 0;
                            width: parent.width * progress;
                            height: parent.height;
                            border-radius: 2px;
                            background: tokens.accent;
                        }
                    }
                    Text {
                        text: Math.round(progress * 100) + "%";
                        color: tokens.muted;
                        font-size: 11px;
                        vertical-alignment: center;
                        width: 34px;
                        horizontal-alignment: right;
                    }
                }
            }
        }

        if settings-open && !focus-mode: Rectangle {
            // A visible scrim: the popover sits over live prose, so it has to
            // read as "above" rather than as a rendering artifact.
            background: #000000.with-alpha(0.3);
            TouchArea {
                clicked => { settings-open = false; keys.focus(); }
            }
        }

        if settings-open && !focus-mode: SettingsPanel {
            x: parent.width - self.width - 12px;
            y: 52px;
            tokens: tokens;
            families: families;
            family-index: family-index;
            justify: justify;
            spotlight: spotlight;
            follow-system: follow-system;
            theme-label: theme-label;
            measure: measure;
            pick-family(index) => { root.pick-family(index); }
            set-justify(on) => { root.set-justify(on); }
            set-spotlight(on) => { root.toggle-spotlight(); }
            set-follow-system(on) => { root.set-follow-system(on); }
            pick-theme(index) => { root.pick-theme(index); }
            set-measure(value) => { root.set-measure(value); }
            dismiss => { settings-open = false; }
        }

        if shortcuts-open: Shortcuts {
            width: parent.width;
            height: parent.height;
            tokens: tokens;
            dismiss => { shortcuts-open = false; keys.focus(); }
        }

        // Transient message (open errors, saved state, and the like).
        if notice != "": Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - (has-book && !focus-mode ? 44px : 24px);
            width: notice-text.preferred-width + 28px;
            height: 34px;
            border-radius: 17px;
            background: tokens.surface;
            border-width: 1px;
            border-color: tokens.border;
            notice-text := Text {
                text: notice;
                color: tokens.text;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }
}
