// Theme tokens, mirrored from folio-core's Theme struct. Colors are defined in
// Rust so the rasterizer and this chrome can never drift apart.
export struct Tokens {
    page: color,
    surface: color,
    text: color,
    muted: color,
    accent: color,
    link: color,
    border: color,
}

export struct TocRow {
    label: string,
    depth: int,
    index: int,
    current: bool,
}

export struct SearchRow {
    label: string,
    snippet: string,
    index: int,
}

export struct ShelfRow {
    title: string,
    author: string,
    progress: int,
    cover: image,
    index: int,
}

// A flat, themed button used across the chrome.
export component ToolButton inherits Rectangle {
    in property <Tokens> tokens;
    in property <string> text;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 30px;
    width: max(34px, label.preferred-width + 18px);
    border-radius: 6px;
    background: active
        ? tokens.accent.with-alpha(0.18)
        : ((touch.has-hover && enabled) ? tokens.text.with-alpha(0.07) : transparent);
    opacity: enabled ? 1.0 : 0.4;
    animate background { duration: 90ms; }

    label := Text {
        text: root.text;
        color: root.active ? tokens.accent : tokens.text;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }

    states [
        pressed when touch.pressed: {
            background: tokens.accent.with-alpha(0.28);
        }
    ]
}
