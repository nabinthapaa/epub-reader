// Theme tokens, mirrored from folio-core's Theme struct. Colors are defined in
// Rust so the rasterizer and this chrome can never drift apart.
export struct Tokens {
    page: color,
    surface: color,
    text: color,
    muted: color,
    accent: color,
    link: color,
    border: color,
    /// Lets the chrome pick a scrim depth without re-deriving luminance.
    dark: bool,
}

export struct TocRow {
    label: string,
    depth: int,
    index: int,
    current: bool,
}

export struct SearchRow {
    label: string,
    /// Markup, not plain text: the matched words are bold, which is the whole
    /// point of a result list you are meant to scan.
    snippet: styled-text,
    index: int,
}

export struct ShelfRow {
    title: string,
    author: string,
    progress: int,
    cover: image,
    index: int,
}

// A flat, themed button used across the chrome.
export component ToolButton inherits Rectangle {
    in property <Tokens> tokens;
    in property <string> text;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();

    // Inside a layout the plain width/height are advisory, so pin the size.
    min-height: 30px;
    max-height: 30px;
    min-width: max(34px, label.preferred-width + 18px);
    max-width: max(34px, label.preferred-width + 18px);
    horizontal-stretch: 0;
    border-radius: 6px;
    background: active
        ? tokens.accent.with-alpha(0.18)
        : ((touch.has-hover && enabled) ? tokens.text.with-alpha(0.07) : transparent);
    opacity: enabled ? 1.0 : 0.4;
    animate background { duration: 90ms; }

    label := Text {
        text: root.text;
        color: root.active ? tokens.accent : tokens.text;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }

    states [
        pressed when touch.pressed: {
            background: tokens.accent.with-alpha(0.28);
        }
    ]
}

// A text field that obeys the theme. The std-widgets LineEdit paints itself
// near-white whatever the palette, which in a dark reading theme makes the
// search box the brightest thing on screen — brighter than the prose.
export component ThemedField inherits Rectangle {
    in property <Tokens> tokens;
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    callback accepted(string);
    callback escaped();

    min-height: 32px;
    max-height: 32px;
    border-radius: 6px;
    background: tokens.page;
    border-width: 1px;
    border-color: input.has-focus ? tokens.accent : tokens.border;

    input := TextInput {
        x: 9px;
        width: parent.width - 18px;
        height: parent.height;
        color: tokens.text;
        font-size: 13px;
        single-line: true;
        vertical-alignment: center;
        selection-background-color: tokens.accent.with-alpha(0.35);
        selection-foreground-color: tokens.text;
        accepted => { root.accepted(self.text); }
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.escaped(); return accept; }
            return reject;
        }
    }

    if input.text == "": Text {
        x: 10px;
        text: placeholder;
        color: tokens.muted;
        font-size: 13px;
        vertical-alignment: center;
        height: parent.height;
    }

    public function focus-field() { input.focus(); }
}

// Likewise for checkboxes: a 16px box drawn from tokens, not from the widget
// library's own palette.
export component ThemedCheck inherits Rectangle {
    in property <Tokens> tokens;
    in property <string> text;
    in property <bool> checked;
    callback toggled(bool);

    min-height: 26px;
    max-height: 26px;

    // The hover tint spills a little past the row so the control still has a
    // target shape, without pushing the checkbox's ink out of alignment.
    Rectangle {
        x: -5px;
        width: parent.width + 10px;
        height: parent.height;
        border-radius: 5px;
        background: touch.has-hover ? tokens.text.with-alpha(0.05) : transparent;
    }

    HorizontalLayout {
        padding-right: 4px;
        spacing: 9px;
        alignment: start;

        Rectangle {
            y: (parent.height - 16px) / 2;
            width: 16px;
            height: 16px;
            border-radius: 4px;
            border-width: 1px;
            border-color: checked ? tokens.accent : tokens.border;
            background: checked ? tokens.accent.with-alpha(0.9) : transparent;
            Text {
                text: checked ? "✓" : "";
                color: tokens.page;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }

        Text {
            text: root.text;
            color: tokens.text;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

// Two real columns: padding a single string with spaces goes ragged in a
// proportional font, which defeats the point of a card you scan.
component ShortcutGroup inherits HorizontalLayout {
    in property <Tokens> tokens;
    in property <string> title;
    in property <[string]> keys;
    in property <[string]> actions;

    spacing: 14px;

    VerticalLayout {
        spacing: 9px;
        alignment: start;
        Text {
            text: title;
            color: tokens.muted;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.6px;
        }
        for key in keys: Text {
            text: key;
            color: tokens.text;
            font-size: 12px;
            font-weight: 600;
            min-height: 17px;
        }
    }

    VerticalLayout {
        spacing: 9px;
        alignment: start;
        Text {
            text: " ";
            font-size: 11px;
        }
        for action in actions: Text {
            text: action;
            color: tokens.muted;
            font-size: 12px;
            min-height: 17px;
        }
    }
}

// The shortcuts card. Nearly everything Folio can do is a keypress, and until
// now the only hints were two muted one-liners.
export component Shortcuts inherits Rectangle {
    in property <Tokens> tokens;
    callback dismiss();

    // One scrim depth for every overlay, and a lighter one on the warm themes
    // where 0.3 black turns cream into olive-grey.
    background: #000000.with-alpha(tokens.dark ? 0.3 : 0.14);
    TouchArea { clicked => { root.dismiss(); } }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 580px;
        height: card.preferred-height;
        // As the settings popover: the software renderer draws no shadow, so
        // the surface and the border carry the elevation themselves.
        background: tokens.surface.mix(tokens.text, 0.94);
        border-width: 1px;
        border-color: tokens.text.with-alpha(0.22);
        border-radius: 12px;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 10px;
        drop-shadow-color: #000000.with-alpha(0.5);

        card := VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: start;

            Text {
                text: "Keyboard shortcuts";
                color: tokens.text;
                font-size: 17px;
                font-weight: 700;
            }

            HorizontalLayout {
                spacing: 32px;

                ShortcutGroup {
                    tokens: tokens;
                    title: "READING";
                    keys: ["Space  PgDn", "↑ ↓   k j", "n   p", "Home", "Backspace"];
                    actions: ["scroll a screen", "scroll a step",
                              "next · previous chapter", "top of the chapter",
                              "back after a link"];
                }

                ShortcutGroup {
                    tokens: tokens;
                    title: "VIEW";
                    keys: ["f", "s", "t", "Ctrl + − 0", "c", "/"];
                    actions: ["focus mode", "spotlight a paragraph",
                              "cycle theme", "zoom in, out, reset",
                              "contents", "search"];
                }
            }

            Text {
                text: "Esc backs out one layer at a time and ends at the shelf  ·  Ctrl+O opens a book  ·  Ctrl+W puts it away";
                color: tokens.muted;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }
}

