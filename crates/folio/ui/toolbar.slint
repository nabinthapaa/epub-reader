import { Tokens, ToolButton } from "tokens.slint";

// The top bar: navigation on the left, view controls on the right, and the
// book's title centred on the window between them.
//
// The title is positioned on the Rectangle rather than placed in the layout:
// inside the layout it centres within the leftover space, and since the right
// cluster is three times the width of the left one, "centred" lands visibly
// off-centre.
export component Toolbar inherits Rectangle {
    in property <Tokens> tokens;
    in property <string> title;
    in property <string> author;
    in property <bool> toc-open;
    in property <bool> search-open;
    in property <bool> settings-open;
    in property <bool> has-book;
    in property <bool> can-go-back;
    in property <int> font-px;

    callback toggle-toc();
    callback toggle-search();
    callback toggle-settings();
    callback open-file();
    callback zoom(int);
    callback zoom-reset();
    callback toggle-focus();
    callback close-book();
    callback back();

    height: 46px;
    background: tokens.surface;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: tokens.border;
    }

    if has-book: HorizontalLayout {
        x: (parent.width - self.width) / 2;
        // Clear whichever cluster is wider, on both sides, so a long title can
        // never slide under a control.
        width: min(self.preferred-width,
            max(120px, parent.width - 2 * max(left-cluster.preferred-width,
                                              right-cluster.preferred-width) - 32px));
        height: parent.height;
        spacing: 0px;

        Text {
            text: title;
            color: tokens.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: author != "" ? "  —  " + author : "";
            color: tokens.muted;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        // Without vertical padding the layout stretches each chip to the full
        // toolbar height, which clips its corners and turns the active state
        // into a slab of colour.
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 4px;

        left-cluster := HorizontalLayout {
            spacing: 4px;
        if has-book: ToolButton {
            tokens: tokens;
            text: "Contents";
            active: toc-open;
            clicked => { toggle-toc(); }
        }
        if has-book: ToolButton {
            tokens: tokens;
            text: "Shelf";
            clicked => { close-book(); }
        }
        if can-go-back: ToolButton {
            tokens: tokens;
            text: "←";
            clicked => { back(); }
        }

        }

        // The gap the title is centred over.
        Rectangle { horizontal-stretch: 1; min-width: 40px; }

        right-cluster := HorizontalLayout {
            spacing: 4px;

        if has-book: ToolButton {
            tokens: tokens;
            text: "Find";
            active: search-open;
            clicked => { toggle-search(); }
        }

        // One zoom control, not three floating chips. The middle is the reset.
        if has-book: Rectangle {
            width: zoom-row.preferred-width;
            horizontal-stretch: 0;
            border-radius: 6px;
            background: tokens.text.with-alpha(0.05);
            zoom-row := HorizontalLayout {
                spacing: 0px;
                ToolButton {
                    tokens: tokens;
                    text: "A−";
                    clicked => { zoom(-1); }
                }
                ToolButton {
                    tokens: tokens;
                    text: font-px + "px";
                    clicked => { zoom-reset(); }
                }
                ToolButton {
                    tokens: tokens;
                    text: "A+";
                    clicked => { zoom(1); }
                }
            }
        }

        if has-book: ToolButton {
            tokens: tokens;
            text: "Focus";
            clicked => { toggle-focus(); }
        }
        ToolButton {
            tokens: tokens;
            text: "Settings";
            active: settings-open;
            clicked => { toggle-settings(); }
        }
        if !has-book: ToolButton {
            tokens: tokens;
            text: "Open";
            clicked => { open-file(); }
        }
        }
    }
}
